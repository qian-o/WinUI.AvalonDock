<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:themes="using:AvalonDock.Themes">
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SubtleFillColorTertiary}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SubtleFillColorTertiary}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
    <Style x:Key="DockNavigatorItemStyle" TargetType="ListViewItem">
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <DataTemplate x:Key="DockNavigatorItemTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Image themes:RetainedIconSource.Source="{Binding LayoutElement.IconSource}" Stretch="None" />
            <TextBlock Grid.Column="1" Margin="4,2,0,2" Text="{Binding LayoutElement.Title}" TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>
    <Style x:Key="AvalonDockNavigatorWindowStyle" TargetType="Control">
        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="WindowBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <Grid Margin="12,10,12,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition MinHeight="54" Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition MinHeight="42" Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Image themes:RetainedIconSource.Source="{Binding SelectedDocument.LayoutElement.IconSource, RelativeSource={RelativeSource TemplatedParent}}" Stretch="None" />
                                        <TextBlock x:Name="selectedElementTitle" Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding SelectedItem.LayoutElement.Title, RelativeSource={RelativeSource TemplatedParent}}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <TextBlock x:Name="selectedElementDescription" Grid.Row="1" VerticalAlignment="Center" Text="{Binding SelectedDocument.LayoutElement.Description, RelativeSource={RelativeSource TemplatedParent}}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Margin="0,3,0,4" FontWeight="SemiBold" Text="{Binding AnchorablesLabel, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <ListView x:Name="PART_AnchorableListBox" Grid.Row="1" MaxHeight="400" SelectionMode="Single" AutomationProperties.Name="{Binding AnchorablesLabel, RelativeSource={RelativeSource TemplatedParent}}" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderThickness="0" ItemContainerStyle="{StaticResource DockNavigatorItemStyle}" ItemTemplate="{StaticResource DockNavigatorItemTemplate}" />
                                    </Grid>
                                    <Grid Grid.Column="1" Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Margin="0,3,0,4" FontWeight="Bold" Text="{Binding DocumentsLabel, RelativeSource={RelativeSource TemplatedParent}}" />
                                        <ListView x:Name="PART_DocumentListBox" Grid.Row="1" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" MaxHeight="400" SelectionMode="Single" AutomationProperties.Name="{Binding DocumentsLabel, RelativeSource={RelativeSource TemplatedParent}}" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderThickness="0" ItemContainerStyle="{StaticResource DockNavigatorItemStyle}" ItemTemplate="{StaticResource DockNavigatorItemTemplate}">
                                            <ListView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Vertical" />
                                                </ItemsPanelTemplate>
                                            </ListView.ItemsPanel>
                                        </ListView>
                                    </Grid>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding SelectedDocument.LayoutElement.ToolTip, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
