    <ControlTemplate x:Key="AvalonDockCenterGlyph" TargetType="ContentControl">
        <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="2" UseLayoutRounding="True" x:Name="Glyph0">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="TargetStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Targeted">
                        <VisualState.Setters>
                            <Setter Target="Glyph0.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                            <Setter Target="Glyph0.BorderBrush" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                            <Setter Target="Glyph2.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                            <Setter Target="Glyph2.BorderBrush" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Canvas Width="24" Height="24" x:Name="Glyph1">
                <Border Width="24" Height="24" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,3,1,1" CornerRadius="0,0,1,1" x:Name="Glyph2" />
            </Canvas>
        </Border>
    </ControlTemplate>
