<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="TabViewItemMinHeight">28</x:Double>
    <x:Double x:Key="TabViewItemHeaderFontSize">12</x:Double>
    <x:Double x:Key="TabViewItemHeaderCloseButtonHeight">20</x:Double>
    <x:Double x:Key="TabViewItemHeaderCloseButtonWidth">20</x:Double>
    <x:Double x:Key="TabViewItemHeaderCloseButtonSize">12</x:Double>
    <Thickness x:Key="TabViewItemHeaderPadding">14,0,4,0</Thickness>
    <Thickness x:Key="TabViewItemHeaderPaddingWithCloseButton">14,0,4,0</Thickness>
    <Thickness x:Key="TabViewItemHeaderPaddingWithoutCloseButton">14,0,4,0</Thickness>
    <Thickness x:Key="TabViewItemSeparatorMargin">0,8,0,8</Thickness>
    <SolidColorBrush x:Key="TabViewBorderBrush"
                     Color="Transparent" />
    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected"
                     Color="Transparent" />
</ResourceDictionary>
