<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:AvalonDock.Controls">
    <Style TargetType="controls:ToggleDockButtonBar">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="controls:ToggleDockButtonBar"><ItemsPresenter /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="controls:ToggleDockButton">
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="25" />
        <Setter Property="Width" Value="25" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="controls:ToggleDockButton">
                <Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Frame.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Frame.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Frame.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Frame.Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Frame.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" /></VisualState.Setters></VisualState>
                            <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Frame.Background" Value="{ThemeResource AccentFillColorTertiaryBrush}" /></VisualState.Setters></VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="AnchorableStates">
                            <VisualState x:Name="AnchorableUnfocused" />
                            <VisualState x:Name="AnchorableFocused"><VisualState.Setters><Setter Target="FocusMark.Visibility" Value="Visible" /></VisualState.Setters></VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                        <Grid>
                            <ContentPresenter x:Name="PART_IconContent" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="PART_Icon" Width="20" Height="20" />
                            <ContentPresenter x:Name="PART_Text" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border x:Name="FocusMark" Width="3" Height="16" Background="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2" Visibility="Collapsed" />
                </Grid>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="controls:ToggleAnchorablePaneTitle">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="controls:ToggleAnchorablePaneTitle">
                <Grid Background="{TemplateBinding Background}" MinHeight="32" Padding="8,2,2,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="PART_Title"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Center" />
                    <Button x:Name="PART_OptionsButton" Grid.Column="1" Width="25" Height="25" MinWidth="0" MinHeight="0" Padding="0" IsTabStop="False" ToolTipService.ToolTip="Options"><FontIcon Glyph="&#xE712;" FontSize="12" /></Button>
                    <Button x:Name="PART_MinimizeButton" Grid.Column="2" Width="25" Height="25" MinWidth="0" MinHeight="0" Padding="0" IsTabStop="False" ToolTipService.ToolTip="Minimize"
                            Command="{Binding LayoutItem.AutoHideCommand, RelativeSource={RelativeSource TemplatedParent}}"><FontIcon Glyph="&#xE921;" FontSize="12" /></Button>
                </Grid>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
</ResourceDictionary>
