<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:AvalonDock.Controls"
                    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
                    xmlns:properties="using:AvalonDock.Properties">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///WinUI.AvalonDock/Themes/Chrome.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="TogglePaneFrameStyle"
           TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DockSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DockBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <SolidColorBrush x:Key="AvalonDock.Controls.ToggleDockButton.ForegroundBrush"
                     Color="{ThemeResource TextFillColorSecondary}" />

    <Style TargetType="controls:ToggleDockButtonBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ToggleDockButtonBar">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="controls:ToggleDockButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{ThemeResource DockControlCornerRadius}" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="FontFamily" Value="{ThemeResource DockFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource DockFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource AvalonDock.Controls.ToggleDockButton.ForegroundBrush}" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="MinHeight" Value="25" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ToggleDockButton">
                    <Grid x:Name="ButtonRoot"
                          Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Frame.Background" Value="{ThemeResource DockHoverBrush}" />
                                        <Setter Target="PART_Text.Foreground" Value="{ThemeResource DockTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Frame.Background" Value="{ThemeResource DockPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ButtonRoot.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Frame.Background" Value="{ThemeResource DockHoverBrush}" />
                                        <Setter Target="PART_Text.Foreground" Value="{ThemeResource DockTextBrush}" />
                                        <Setter Target="Indicator.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Frame.Background" Value="{ThemeResource DockHoverBrush}" />
                                        <Setter Target="PART_Text.Foreground" Value="{ThemeResource DockTextBrush}" />
                                        <Setter Target="Indicator.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Frame.Background" Value="{ThemeResource DockPressedBrush}" />
                                        <Setter Target="PART_Text.Foreground" Value="{ThemeResource DockTextBrush}" />
                                        <Setter Target="Indicator.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="ButtonRoot.Opacity" Value="0.5" />
                                        <Setter Target="Indicator.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="AnchorableStates">
                                <VisualState x:Name="AnchorableUnfocused" />
                                <VisualState x:Name="AnchorableFocused">
                                    <VisualState.Setters>
                                        <Setter Target="Indicator.Background" Value="{ThemeResource DockTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ZoneStates">
                                <VisualState x:Name="IndicatorLeft" />
                                <VisualState x:Name="IndicatorRight">
                                    <VisualState.Setters>
                                        <Setter Target="Indicator.HorizontalAlignment" Value="Right" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Frame"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid>
                                <ContentPresenter x:Name="PART_IconContent"
                                                  Width="20"
                                                  Height="20"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                <Image x:Name="PART_Icon"
                                       Width="20"
                                       Height="20" />
                                <ContentPresenter x:Name="PART_Text"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <Border x:Name="Indicator"
                                Width="2"
                                Margin="0,10"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource DockSecondaryTextBrush}"
                                CornerRadius="1"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Width" Value="25" />
    </Style>
    <Style TargetType="controls:ToggleAnchorablePaneTitle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{ThemeResource DockFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource DockFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource DockTextBrush}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ToggleAnchorablePaneTitle">
                    <Grid Padding="12,2,4,2"
                          Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="PART_Title"
                                          Margin="0,0,8,0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center"
                                          FontWeight="SemiBold" />
                        <Button x:Name="PART_OptionsButton"
                                Grid.Column="1"
                                Width="24"
                                Height="24"
                                MinWidth="0"
                                MinHeight="0"
                                Margin="2,0"
                                Padding="0"
                                AutomationProperties.Name="{properties:LocalizedString Key=Toggle_Options}"
                                IsTabStop="False"
                                Style="{StaticResource AvalonDockChromeButtonStyle}"
                                ToolTipService.ToolTip="{properties:LocalizedString Key=Toggle_Options}">
                            <FontIcon FontSize="14"
                                      Glyph="&#xE712;" />
                        </Button>
                        <Button x:Name="PART_MinimizeButton"
                                Grid.Column="2"
                                Width="24"
                                Height="24"
                                MinWidth="0"
                                MinHeight="0"
                                Margin="2,0"
                                Padding="0"
                                AutomationProperties.Name="{properties:LocalizedString Key=Toggle_Minimize}"
                                Command="{Binding LayoutItem.AutoHideCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                IsTabStop="False"
                                Style="{StaticResource AvalonDockChromeButtonStyle}"
                                ToolTipService.ToolTip="{properties:LocalizedString Key=Toggle_Minimize}">
                            <FontIcon FontSize="14"
                                      Glyph="&#xE921;" />
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="AvalonDockTogglePaneControlStyle"
           TargetType="controls:TabControlEx">
        <Setter Property="Background" Value="{ThemeResource DockSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DockBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontFamily" Value="{ThemeResource DockFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource DockFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource DockTextBrush}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="KeyboardAcceleratorPlacementMode" Value="Hidden" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:TabControlEx">
                    <Grid>
                        <Grid.Resources>
                            <ResourceDictionary Source="ms-appx:///WinUI.AvalonDock/Themes/DockingResources.xaml" />
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ToolCountStates">
                                <VisualState x:Name="MultipleTools" />
                                <VisualState x:Name="SingleTool">
                                    <VisualState.Setters>
                                        <Setter Target="TabStrip.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="EmptyTool">
                                    <VisualState.Setters>
                                        <Setter Target="PaneFrame.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ToolHostStates">
                                <VisualState x:Name="DockedTool" />
                                <VisualState x:Name="FloatingTool">
                                    <VisualState.Setters>
                                        <Setter Target="PaneFrame.BorderBrush" Value="Transparent" />
                                        <Setter Target="PaneFrame.CornerRadius" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="PaneActivationStates">
                                <VisualState x:Name="PaneInactive" />
                                <VisualState x:Name="PaneActive" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="PaneFrame"
                                Grid.RowSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="ContentPanel"
                                Margin="{TemplateBinding Padding}"
                                Background="Transparent"
                                TabFocusNavigation="Cycle">
                            <Grid x:Name="PART_ItemsHolder" />
                        </Border>
                        <Border x:Name="TabStrip"
                                Grid.Row="1"
                                Padding="4,0"
                                Background="{ThemeResource DockChromeBrush}"
                                BorderBrush="{ThemeResource DockBorderBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,5,5">
                            <primitives:TabViewListView x:Name="TabListView"
                                                        HorizontalAlignment="Stretch"
                                                        AllowDrop="{TemplateBinding AllowDropTabs}"
                                                        CanDragItems="{TemplateBinding CanDragTabs}"
                                                        CanReorderItems="{TemplateBinding CanReorderTabs}"
                                                        ItemTemplate="{TemplateBinding TabItemTemplate}"
                                                        ItemTemplateSelector="{TemplateBinding TabItemTemplateSelector}"
                                                        ItemsSource="{TemplateBinding TabItemsSource}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
</ResourceDictionary>
