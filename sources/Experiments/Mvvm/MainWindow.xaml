<Window x:Class="WinUI.AvalonDock.Experiments.Mvvm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Microsoft.UI.Xaml.Controls"
        xmlns:dock="using:AvalonDock">
    <Grid x:Name="PageRoot"
          Padding="8"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:MenuBar Grid.Row="0">
            <controls:MenuBarItem Title="File">
                <controls:MenuFlyoutItem Command="{x:Bind ViewModel.OpenCommand}"
                                         Text="New Document" />
                <controls:MenuFlyoutItem Command="{x:Bind ViewModel.SaveCommand}"
                                         Text="Save Active Document" />
                <controls:MenuFlyoutItem Command="{x:Bind ViewModel.CloseActiveCommand}"
                                         Text="Close Active Document" />
            </controls:MenuBarItem>
            <controls:MenuBarItem Title="Edit">
                <controls:MenuFlyoutItem Command="{x:Bind ViewModel.MarkModifiedCommand}"
                                         Text="Mark Active Document as Modified" />
                <controls:MenuFlyoutItem Command="{x:Bind ViewModel.NextCommand}"
                                         Text="Next Document" />
                <controls:MenuFlyoutItem Command="{x:Bind ViewModel.ReplaceCommand}"
                                         Text="Replace Active Document" />
                <controls:MenuFlyoutItem Command="{x:Bind ViewModel.ResetCommand}"
                                         Text="Reset Documents" />
            </controls:MenuBarItem>
            <controls:MenuBarItem Title="Tools">
                <controls:MenuFlyoutItem Command="{x:Bind ViewModel.AddToolCommand}"
                                         Text="Add Tool" />
                <controls:MenuFlyoutItem Command="{x:Bind ViewModel.ReplaceToolCommand}"
                                         Text="Replace Tool" />
                <controls:MenuFlyoutItem Command="{x:Bind ViewModel.ResetToolsCommand}"
                                         Text="Reset Tools" />
            </controls:MenuBarItem>
            <controls:MenuBarItem Title="Layout">
                <controls:MenuFlyoutItem Click="SaveLayout_Click"
                                         Text="Save Layout" />
                <controls:MenuFlyoutItem Click="RestoreLayout_Click"
                                         Text="Restore Layout" />
                <controls:MenuFlyoutSeparator />
                <controls:MenuFlyoutItem Command="{x:Bind ViewModel.ToggleFloatingCommand}"
                                         Text="Toggle Floating Window Policy" />
            </controls:MenuBarItem>
            <controls:MenuBarItem Title="Theme">
                <controls:MenuFlyoutItem Click="ToggleTheme_Click"
                                         Text="Toggle Light/Dark Theme" />
            </controls:MenuBarItem>
        </controls:MenuBar>
        <TextBlock Grid.Row="1"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        <dock:DockingManager x:Name="Manager"
                             Grid.Row="2"
                             DockLayout="{x:Bind ViewModel.Layout, Mode=OneWay}"
                             LayoutItemTemplate="{StaticResource WorkspaceContentTemplate}" />
        <TextBlock Grid.Row="3"
                   Opacity="0.75"
                   Text="The ViewModel manages documents and tools. Use Edit to mark a document as modified, then try saving, closing, replacing, resetting, and restoring the layout." />
    </Grid>
</Window>
