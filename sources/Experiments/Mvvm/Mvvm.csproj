<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>$(StandardTargetFramework)-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
        <UseWinUI>true</UseWinUI>
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <PlatformTarget>x64</PlatformTarget>
        <IsPackable>false</IsPackable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
        <RootNamespace>WinUI.AvalonDock.Experiments.Mvvm</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Dirkster.AvalonDock.Mvvm" />
        <PackageReference Include="Dirkster.AvalonDock.Serializer.Xml" />
        <ProjectReference Include="../../WinUI.AvalonDock/WinUI.AvalonDock.csproj" />
        <Compile Include="../Shared/WorkspaceContent.cs" Link="Shared/WorkspaceContent.cs" />
        <Compile Include="../Shared/SampleStyles.cs" Link="Shared/SampleStyles.cs" />
        <Compile Include="../Shared/SampleChecks.cs" Link="Shared/SampleChecks.cs" />
    </ItemGroup>
</Project>
