<Window x:Class="WinUI.AvalonDock.Experiments.Docking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Microsoft.UI.Xaml.Controls"
        xmlns:dock="using:AvalonDock"
        xmlns:layout="using:AvalonDock.Layout">
    <Grid x:Name="PageRoot"
          Padding="8"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:MenuBar Grid.Row="0">
            <controls:MenuBarItem Title="File">
                <controls:MenuFlyoutItem Click="AddDocument_Click"
                                         Text="New Document" />
                <controls:MenuFlyoutItem Click="ReplaceDocument_Click"
                                         Text="Replace Document Source" />
                <controls:MenuFlyoutItem Click="ResetDocuments_Click"
                                         Text="Reset Document Source" />
            </controls:MenuBarItem>
            <controls:MenuBarItem Title="Edit">
                <controls:MenuFlyoutItem Click="MarkActiveDocumentModified_Click"
                                         Text="Mark Active Document as Modified" />
                <controls:MenuFlyoutItem Click="CloseActive_Click"
                                         Text="Close Active Item" />
                <controls:ToggleMenuFlyoutItem x:Name="AllowCloseModifiedMenuItem"
                                               Click="AllowCloseModified_Click"
                                               IsChecked="False"
                                               Text="Allow Closing Modified Items" />
            </controls:MenuBarItem>
            <controls:MenuBarItem Title="Layout">
                <controls:MenuFlyoutItem Click="SaveLayout_Click"
                                         Text="Save Layout" />
                <controls:MenuFlyoutItem Click="RestoreLayout_Click"
                                         Text="Restore Layout" />
                <controls:MenuFlyoutSeparator />
                <controls:MenuFlyoutItem Click="FloatActive_Click"
                                         Text="Float Active Item" />
                <controls:MenuFlyoutItem Click="DockActive_Click"
                                         Text="Dock Active Item" />
                <controls:MenuFlyoutItem Click="ToggleWindowPolicy_Click"
                                         Text="Toggle Floating Window Policy" />
            </controls:MenuBarItem>
            <controls:MenuBarItem Title="Tools">
                <controls:MenuFlyoutItem Click="AutoHideTool_Click"
                                         Text="Auto Hide Tool" />
                <controls:MenuFlyoutItem Click="ShowHiddenTool_Click"
                                         Text="Show Hidden Tool" />
                <controls:MenuFlyoutItem Click="ToggleToolFloating_Click"
                                         Text="Float or Dock Tool" />
            </controls:MenuBarItem>
            <controls:MenuBarItem Title="Theme">
                <controls:MenuFlyoutItem Click="ToggleTheme_Click"
                                         Text="Toggle Light/Dark Theme" />
            </controls:MenuBarItem>
        </controls:MenuBar>
        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Text="Classic workspace using XAML LayoutRoot and data sources." />
        <dock:DockingManager x:Name="Manager"
                             Grid.Row="2"
                             AllowDetachedWindows="True"
                             AllowFloatingWindows="True"
                             LayoutItemTemplate="{StaticResource WorkspaceContentTemplate}">
            <layout:LayoutRoot>
                <layout:LayoutPanel Orientation="Horizontal">
                    <layout:LayoutAnchorablePaneGroup DockWidth="280">
                        <layout:LayoutAnchorablePane />
                    </layout:LayoutAnchorablePaneGroup>
                    <layout:LayoutDocumentPaneGroup>
                        <layout:LayoutDocumentPane />
                    </layout:LayoutDocumentPaneGroup>
                </layout:LayoutPanel>
            </layout:LayoutRoot>
        </dock:DockingManager>
        <TextBlock Grid.Row="3"
                   Opacity="0.75"
                   Text="Drag document tabs or tool headers to rearrange the workspace with docking guides. Right-click a tab for more commands." />
    </Grid>
</Window>
