<Window
    x:Class="WinUI.AvalonDock.Experiments.Docking.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:dock="using:AvalonDock"
    xmlns:layout="using:AvalonDock.Layout">
    <Grid x:Name="PageRoot" Padding="8" RowSpacing="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:MenuBar Grid.Row="0">
            <controls:MenuBarItem Title="文件">
                <controls:MenuFlyoutItem Text="新建文档" Click="AddDocument_Click" />
                <controls:MenuFlyoutItem Text="替换文档源" Click="ReplaceDocument_Click" />
                <controls:MenuFlyoutItem Text="重置文档源" Click="ResetDocuments_Click" />
            </controls:MenuBarItem>
            <controls:MenuBarItem Title="编辑">
                <controls:MenuFlyoutItem Text="关闭活动项" Click="CloseActive_Click" />
                <controls:ToggleMenuFlyoutItem x:Name="AllowCloseModifiedMenuItem"
                                                Text="允许关闭修改项"
                                                IsChecked="False"
                                                Click="AllowCloseModified_Click" />
            </controls:MenuBarItem>
            <controls:MenuBarItem Title="布局">
                <controls:MenuFlyoutItem Text="保存布局" Click="SaveLayout_Click" />
                <controls:MenuFlyoutItem Text="恢复布局" Click="RestoreLayout_Click" />
                <controls:MenuFlyoutSeparator />
                <controls:MenuFlyoutItem Text="浮动活动项" Click="FloatActive_Click" />
                <controls:MenuFlyoutItem Text="重新停靠活动项" Click="DockActive_Click" />
                <controls:MenuFlyoutItem Text="切换浮动窗口策略" Click="ToggleWindowPolicy_Click" />
            </controls:MenuBarItem>
            <controls:MenuBarItem Title="工具">
                <controls:MenuFlyoutItem Text="自动隐藏工具" Click="AutoHideTool_Click" />
                <controls:MenuFlyoutItem Text="显示隐藏工具" Click="ShowHiddenTool_Click" />
                <controls:MenuFlyoutItem Text="拆分或附回工具" Click="DetachTool_Click" />
            </controls:MenuBarItem>
            <controls:MenuBarItem Title="主题">
                <controls:MenuFlyoutItem Text="切换浅色/深色主题" Click="ToggleTheme_Click" />
            </controls:MenuBarItem>
        </controls:MenuBar>
        <TextBlock x:Name="StatusText" Grid.Row="1" Text="Docking：XAML LayoutRoot 与数据源工作区。" />
        <dock:DockingManager x:Name="Manager" Grid.Row="2"
                             AllowFloatingWindows="True"
                             AllowDetachedWindows="True"
                             LayoutItemTemplate="{StaticResource WorkspaceContentTemplate}">
            <layout:LayoutRoot>
                <layout:LayoutPanel Orientation="Horizontal">
                    <layout:LayoutAnchorablePaneGroup DockWidth="280">
                        <layout:LayoutAnchorablePane />
                    </layout:LayoutAnchorablePaneGroup>
                    <layout:LayoutDocumentPaneGroup>
                        <layout:LayoutDocumentPane />
                    </layout:LayoutDocumentPaneGroup>
                </layout:LayoutPanel>
            </layout:LayoutRoot>
        </dock:DockingManager>
        <TextBlock Grid.Row="3" Text="拖动文档标签或工具标题栏，使用停靠引导重新排列工作区；右键标签可打开上下文命令。" Opacity="0.75" />
    </Grid>
</Window>
