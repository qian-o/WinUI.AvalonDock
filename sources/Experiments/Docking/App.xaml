<Application
    x:Class="WinUI.AvalonDock.Experiments.Docking.DockingApplication"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="WorkspaceContentTemplate">
                <StackPanel Padding="20" Spacing="12">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox Text="{Binding Text, Mode=TwoWay}" AcceptsReturn="True" MinHeight="180" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
