<Window
    x:Class="WinUI.AvalonDock.Experiments.ToggleDocking.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:dock="using:AvalonDock">
    <Grid x:Name="PageRoot" Padding="8" RowSpacing="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:MenuBar Grid.Row="0">
            <controls:MenuBarItem Title="File">
                <controls:MenuFlyoutItem Text="New Document" Click="AddDocument_Click" />
            </controls:MenuBarItem>
            <controls:MenuBarItem Title="Layout">
                <controls:MenuFlyoutItem Text="Detach or Reattach Current Tool" Click="DetachTool_Click" />
                <controls:MenuFlyoutSeparator />
                <controls:MenuFlyoutItem Text="Upper Left Zone" Click="MoveLeftTop_Click" />
                <controls:MenuFlyoutItem Text="Lower Left Zone" Click="MoveLeftBottom_Click" />
                <controls:MenuFlyoutItem Text="Upper Right Zone" Click="MoveRightTop_Click" />
                <controls:MenuFlyoutItem Text="Lower Right Zone" Click="MoveRightBottom_Click" />
                <controls:MenuFlyoutItem Text="Bottom Left Zone" Click="MoveBottomLeft_Click" />
                <controls:MenuFlyoutItem Text="Bottom Right Zone" Click="MoveBottomRight_Click" />
            </controls:MenuBarItem>
            <controls:MenuBarItem Title="View">
                <controls:MenuFlyoutItem Text="Toggle Current Tool" Click="ToggleTool_Click" />
                <controls:MenuFlyoutItem Text="Show Hidden Tool" Click="ShowHiddenTool_Click" />
                <controls:MenuFlyoutSeparator />
                <controls:MenuFlyoutItem Text="Bottom Spans Full Width" Click="BottomFullWidth_Click" />
                <controls:MenuFlyoutItem Text="Sides Span Full Height" Click="SidesFullHeight_Click" />
                <controls:MenuFlyoutItem Text="Default Layout Priority" Click="DefaultLayoutPriority_Click" />
            </controls:MenuBarItem>
            <controls:MenuBarItem Title="Theme">
                <controls:MenuFlyoutItem Text="Toggle Light/Dark Theme" Click="ToggleTheme_Click" />
            </controls:MenuBarItem>
        </controls:MenuBar>
        <TextBlock x:Name="StatusText" Grid.Row="1" Text="ToggleDocking: six tool zones with sidebar buttons." />
        <dock:ToggleDockingManager x:Name="Manager" Grid.Row="2"
                                   ButtonSize="40"
                                   LayoutPriority="BottomFullWidth"
                                   LayoutItemTemplate="{StaticResource WorkspaceContentTemplate}" />
        <TextBlock Grid.Row="3" Text="Each tool's Zone selects a sidebar position. Drag a tool to explore the zone guides." Opacity="0.75" />
    </Grid>
</Window>
