<Window x:Class="WinUI.AvalonDock.Experiments.ToggleDocking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Microsoft.UI.Xaml.Controls"
        xmlns:dock="using:AvalonDock">
    <Grid x:Name="PageRoot"
          Padding="8"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:MenuBar Grid.Row="0">
            <controls:MenuBarItem Title="File">
                <controls:MenuFlyoutItem Click="AddDocument_Click"
                                         Text="New Document" />
            </controls:MenuBarItem>
            <controls:MenuBarItem Title="Layout">
                <controls:MenuFlyoutItem Click="DetachTool_Click"
                                         Text="Detach or Reattach Current Tool" />
                <controls:MenuFlyoutSeparator />
                <controls:MenuFlyoutItem Click="MoveLeftTop_Click"
                                         Text="Upper Left Zone" />
                <controls:MenuFlyoutItem Click="MoveLeftBottom_Click"
                                         Text="Lower Left Zone" />
                <controls:MenuFlyoutItem Click="MoveRightTop_Click"
                                         Text="Upper Right Zone" />
                <controls:MenuFlyoutItem Click="MoveRightBottom_Click"
                                         Text="Lower Right Zone" />
                <controls:MenuFlyoutItem Click="MoveBottomLeft_Click"
                                         Text="Bottom Left Zone" />
                <controls:MenuFlyoutItem Click="MoveBottomRight_Click"
                                         Text="Bottom Right Zone" />
            </controls:MenuBarItem>
            <controls:MenuBarItem Title="View">
                <controls:MenuFlyoutItem Click="ToggleTool_Click"
                                         Text="Toggle Current Tool" />
                <controls:MenuFlyoutItem Click="ShowHiddenTool_Click"
                                         Text="Show Hidden Tool" />
                <controls:MenuFlyoutSeparator />
                <controls:MenuFlyoutItem Click="BottomFullWidth_Click"
                                         Text="Bottom Spans Full Width" />
                <controls:MenuFlyoutItem Click="SidesFullHeight_Click"
                                         Text="Sides Span Full Height" />
                <controls:MenuFlyoutItem Click="DefaultLayoutPriority_Click"
                                         Text="Default Layout Priority" />
            </controls:MenuBarItem>
            <controls:MenuBarItem Title="Theme">
                <controls:MenuFlyoutItem Click="ToggleTheme_Click"
                                         Text="Toggle Light/Dark Theme" />
            </controls:MenuBarItem>
        </controls:MenuBar>
        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Text="ToggleDocking: six tool zones with sidebar buttons." />
        <dock:ToggleDockingManager x:Name="Manager"
                                   Grid.Row="2"
                                   ButtonSize="40"
                                   LayoutItemTemplate="{StaticResource WorkspaceContentTemplate}"
                                   LayoutPriority="BottomFullWidth" />
        <TextBlock Grid.Row="3"
                   Opacity="0.75"
                   Text="Each tool's Zone selects a sidebar position. Drag a tool to explore the zone guides." />
    </Grid>
</Window>
