<Window
    x:Class="WinUI.AvalonDock.Experiments.ToggleDockingManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dock="using:AvalonDock">
    <Grid x:Name="PageRoot" Padding="8" RowSpacing="8" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="新增文档" Click="AddDocument_Click" />
                <Button Content="切换当前工具" Click="ToggleTool_Click" />
                <Button Content="显示隐藏工具" Click="ShowHiddenTool_Click" />
                <Button Content="拆分/附回工具" Click="DetachTool_Click" />
                <Button Content="左上" Click="MoveLeftTop_Click" />
                <Button Content="左下" Click="MoveLeftBottom_Click" />
                <Button Content="右上" Click="MoveRightTop_Click" />
                <Button Content="右下" Click="MoveRightBottom_Click" />
                <Button Content="底左" Click="MoveBottomLeft_Click" />
                <Button Content="底右" Click="MoveBottomRight_Click" />
                <Button Content="切换主题" Click="ToggleTheme_Click" />
            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="StatusText" Grid.Row="1" Text="ToggleDockingManager：六个工具区和按钮栏。" />
        <dock:ToggleDockingManager x:Name="Manager" Grid.Row="2"
                                   LayoutPriority="BottomFullWidth"
                                   LayoutItemTemplate="{StaticResource WorkspaceContentTemplate}" />
        <TextBlock Grid.Row="3" Text="每个工具模型的 Zone 决定左上、左下、右上、右下、底左或底右；拖动工具可测试区域引导。" Opacity="0.75" />
    </Grid>
</Window>
